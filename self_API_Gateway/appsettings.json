{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    },
    "File": {
      "Directory": "logs",
      "LogLevel": {
        "Default": "Warning"
      }
    }
  },
  "AllowedHosts": "*",
  "Gateway": {
    "Routes": [
      {
        "Id": "todos",
        "PathPrefix": "/api/todos",
        "ClusterId": "todo-cluster",
        "RateLimitPolicy": "per-ip"
      }
    ],
    "RateLimitPolicies": {
      "per-ip": {
        "Algorithm": "TokenBucket",
        "PartitionBy": "Ip",
        "PermitLimit": 100,
        "TokensPerPeriod": 50,
        "WindowSeconds": 1,
        "QueueLimit": 0
      }
    },
    "KnownProxies": [],
    "KnownNetworks": [],
    "Clusters": {
      "todo-cluster": {
        "LoadBalancing": "RoundRobin",
        "HealthCheck": {
          "Path": "/health",
          "IntervalSeconds": 10
        },
        "Destinations": [
          "http://todo-1:8080",
          "http://todo-2:8080"
        ]
      }
    }
  }
}